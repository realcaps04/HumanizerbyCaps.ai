{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npm run vercel-build",
      "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../web ../../packages/shared ../../vercel.json ../../scripts ../../package.json || exit 1",
      "functions": {
        "src/index.ts": {
          "includeFiles": "public/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "api"
      }
    }
  ]
}
