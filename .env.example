# API
PORT=4000
JWT_SECRET=change-me-in-production
DATA_DIR=./data
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to "mock" to run without an API key
AI_PROVIDER=mock

# Web (Vite)
# Leave empty so the browser uses same-origin `/api/...` paths.
# - Local Vite proxies /api → localhost:4000
# - Vercel rewrites /api → `api` service
# Do NOT set VITE_API_URL to a hardcoded host in production.
VITE_API_URL=
